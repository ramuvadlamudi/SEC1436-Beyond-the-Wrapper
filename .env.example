# Copy this file to .env. Never commit the populated .env file.

SPLUNK_URL=https://splunk.example.invalid:8089
SPLUNK_USERNAME=
SPLUNK_PASSWORD=
SPLUNK_VERIFY_SSL=true
SPLUNK_TIMEOUT=180

OLLAMA_URL=http://ollama.example.invalid:11434
OLLAMA_FAST_MODEL=
OLLAMA_REASONING_MODEL=
OLLAMA_EMBEDDING_MODEL=
OLLAMA_TIMEOUT=600
OLLAMA_KEEP_ALIVE=30m

ARIA_AUDIT_ENABLED=true
ARIA_AUDIT_CAPTURE_FULL_TEXT=false
ARIA_AUDIT_DIR=data/audit
ARIA_LLM_GATEWAY_HOST=127.0.0.1
ARIA_LLM_GATEWAY_PORT=8502
ARIA_PRODUCT_HOST=127.0.0.1
ARIA_PRODUCT_PORT=8501

# Optional: replace the bundled public-framework reference cards.
# ARIA_V3_REFERENCE_CARDS_PATH=/opt/aria-pattern-b/product/knowledge/reference_cards.json

