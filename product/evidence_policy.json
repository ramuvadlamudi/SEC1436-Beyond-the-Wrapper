{
  "policy_name": "ARIA Evidence Qualification Policy",
  "policy_version": "3.0.0-rc11",
  "candidate_limit": 4,
  "accepted_source_limit": 1,
  "profile_field_limit": 48,
  "profile_sample_value_limit": 3,
  "cooccurrence_event_limit": 200,
  "execution_event_limit": 500,
  "result_limit": 30,
  "minimum_required_coverage": 0.6,
  "minimum_source_score": 55.0,
  "require_required_field_presence": true,
  "require_cooccurrence_for_multiple_required_concepts": true,
  "confidence_weights": {
    "required_concept_coverage": 35,
    "field_observation": 15,
    "cooccurrence": 20,
    "search_result_support": 15,
    "cross_source_corroboration": 10,
    "reasoning_traceability": 5
  },
  "confidence_penalties": {
    "missing_required_concept": 10,
    "contradicting_claim": 8,
    "stale_or_unbounded_time": 5,
    "execution_error": 15
  },
  "minimum_llm_suitability": "MEDIUM",
  "historical_candidate_limit": 3,
  "qualification_batch_size": 2,
  "recovery_candidate_limit": 1,
  "qualification_prompt_field_limit": 24,
  "semantic_positive_candidate_limit": 1,
  "candidate_model_timeout_seconds": 30,
  "qualification_model_timeout_seconds": 60,
  "qualification_retry_timeout_seconds": 30,
  "strategy_model_timeout_seconds": 45,
  "reasoning_model_timeout_seconds": 60,
  "followup_llm_enabled": false,
  "profile_search_timeout_seconds": 60,
  "execution_search_timeout_seconds": 90,
  "runtime_budget_seconds": 300,
  "max_total_candidates_profiled": 6,
  "intent_model_timeout_seconds": 20,
  "scope_model_timeout_seconds": 20,
  "route_repair_timeout_seconds": 30,
  "plan_model_timeout_seconds": 60,
  "plan_repair_timeout_seconds": 45,
  "conversation_model_timeout_seconds": 75,
  "conversation_retry_timeout_seconds": 45,
  "spl_explanation_timeout_seconds": 60,
  "template_model_timeout_seconds": 60,
  "deliverable_model_timeout_seconds": 120,
  "followup_model_timeout_seconds": 20,
  "recovery_minimum_budget_seconds": 35,
  "historical_recovery_minimum_budget_seconds": 45,
  "reasoning_minimum_budget_seconds": 10,
  "semantic_field_binding_enabled": true,
  "semantic_field_binding_field_limit": 48,
  "semantic_field_embedding_timeout_seconds": 20,
  "semantic_field_min_score": 0.42,
  "semantic_field_strong_score": 0.48,
  "semantic_field_min_margin": 0.015,
  "semantic_field_exact_bonus": 0.1,
  "llm_suitability_advisory_when_live_evidence_validated": true,
  "strategy_llm_enabled": false,
  "reasoning_llm_enabled": false,
  "qualification_llm_enabled": false,
  "build_spl_candidate_limit": 50,
  "build_spl_generic_timeout_seconds": 20,
  "build_spl_strategy_timeout_seconds": 45,
  "build_spl_max_profiles": 30,
  "build_spl_profile_batch_size": 5,
  "build_spl_live_budget_seconds": 240,
  "build_spl_catalog_embedding_timeout_seconds": 25,
  "build_spl_value_probe_event_limit": 500,
  "build_spl_value_probe_field_limit": 24,
  "v3_build_candidate_limit": 8,
  "v3_build_budget_seconds": 120,
  "v3_investigation_budget_seconds": 300,
  "v3_triage_budget_seconds": 120,
  "v3_telemetry_cache_ttl_seconds": 900
}
